APP_NAME=SmartPark API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=smartpark

# Cache opcional de disponibilidad (requiere iniciar el servicio Redis)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_AVAILABILITY_TTL_SECONDS=60

# Seguridad: genera una clave aleatoria de al menos 32 caracteres.
# Ejemplo: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# El correo registrado con esta dirección recibe el rol admin.
# Los demás usuarios se registran con rol user; manager se asigna desde una cuenta admin.
ADMIN_EMAIL=admin@gmail.com
